# ============================================================
# Home Network Security Stack - Environment Configuration
# Copy this to .env and change the passwords.
# ============================================================

# Timezone (e.g. America/New_York, Asia/Kolkata, Europe/London)
TZ=UTC

# Pi-hole admin password (CHANGE THIS)
PIHOLE_PASSWORD=changeme

# Grafana admin credentials (CHANGE THESE)
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Port mappings (override if these are taken on your host)
PIHOLE_DNS_PORT=53
PIHOLE_WEB_PORT=8081
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
PORTAINER_PORT=9000

# Docker group ID (run `getent group docker | cut -d: -f3` to find yours)
DOCKER_GID=999
